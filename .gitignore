# Build output. Keep Java source packages named "build" tracked.
/.gradle/
/build/
/fabric-mod/.gradle/
/fabric-mod/build/
/fabric-mod/run/
/fabric-mod/logs/

# Editors and local tooling.
**/.idea/
**/.vscode/
*.iml
.DS_Store
Thumbs.db
/.codex/

# Credentials, world data and generated requests.
.env
.env.*
!.env.example
**/client-secrets.properties
**/config/craftgpt/
**/.minecraft/
/fabric-mod/saves/
*.log
*.jsonl
hs_err_pid*

# JARs belong in GitHub Releases, not source history.
*.jar
!fabric-mod/gradle/wrapper/gradle-wrapper.jar
*.zip
/releases/*
!/releases/README.md
!/releases/.gitkeep
